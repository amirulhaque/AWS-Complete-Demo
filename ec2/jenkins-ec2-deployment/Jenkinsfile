pipeline {

    agent any

    environment {
        APP_DIR = "/home/ec2-user/sample-python-app"
    }

    stages {

        stage('Clone Repository') {
            steps {
                git branch: 'main', url: 'https://github.com/amirulhaque/AWS-Complete-Demo.git'
            }
        }

        stage('Deploy to EC2') {
            steps {
                sshagent(['ec2-deploy-key']) {
                    sh """
                        echo "Deploying to EC2 at \$TARGET_IP ..."

                        ssh -o StrictHostKeyChecking=no ec2-user@\$TARGET_IP '
                            set -e

                            # Install Python
                            command -v python3 >/dev/null 2>&1 || sudo yum install -y python3 || sudo apt-get install -y python3;

                            # Remove old deployment
                            rm -rf ${APP_DIR};

                            # Clone your real repo into EC2
                            git clone https://github.com/amirulhaque/AWS-Complete-Demo.git ${APP_DIR};

                            # IMPORTANT: Navigate into the folder where app actually exists
                            cd ${APP_DIR}/ec2/jenkins-ec2-deployment;

                            python3 -m venv venv;
                            source venv/bin/activate;
                            pip install -r requirements.txt;

                            # Stop old app
                            pkill -f "python3 app.py" || true;

                            # Start new app
                            nohup python3 app.py > app.log 2>&1 &
                        '
                    """
                }
            }
        }
    }

    post {
        success {
            echo "✅ Successfully deployed! Visit: http://\$TARGET_IP:5000 [$target_ip]"
        }
        failure {
            echo "❌ Deployment failed. Check Jenkins console output."
        }
    }
}
